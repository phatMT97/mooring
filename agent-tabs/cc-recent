#!/usr/bin/env python3
"""List recent Claude Code sessions and reopen them in Windows Terminal tabs.

  cc-recent                 sessions touched in the last 36h
  cc-recent -H 72           look back 72h
  cc-recent --open          reopen ALL listed sessions, one WT tab each
  cc-recent --open 1,3,5    reopen only those rows
  cc-recent --cmd vclaude   launcher used for resume (default: $CC_RECENT_CMD or claude)
"""
import argparse, glob, json, os, shlex, subprocess, time
from datetime import datetime

PROJECTS = os.path.expanduser("~/.claude-work/projects")


def read_session(path):
    info = {"id": os.path.basename(path)[:-6], "mtime": os.path.getmtime(path),
            "cwd": None, "title": None, "ai_title": None, "first": None, "last": None}
    with open(path, errors="ignore") as f:
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            t = d.get("type")
            if t == "custom-title":
                info["title"] = d.get("customTitle") or info["title"]
            elif t == "ai-title":
                info["ai_title"] = d.get("aiTitle") or info["ai_title"]
            elif t == "last-prompt":
                info["last"] = d.get("lastPrompt") or info["last"]
            elif t == "user" and not d.get("isSidechain"):
                info["cwd"] = info["cwd"] or d.get("cwd")
                c = d.get("message", {}).get("content")
                if info["first"] is None and isinstance(c, str) and not c.startswith("<"):
                    info["first"] = c
    info["name"] = info["title"] or info["ai_title"] or (info["first"] or "")[:60]
    return info


def one_line(s, n):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[: n - 1] + "…"


def open_tabs(rows, cmd):
    # Queue each session for agent-tabs, then open a plain tab in its directory: the tab's
    # .bashrc offers the resume, and Windows Terminal never saves a "--resume <id>" command.
    for r in rows:
        subprocess.run(["agent-tabs", "add", cmd, "claude", r["id"], r["cwd"] or os.path.expanduser("~"), r["name"]])
    for cwd in dict.fromkeys(r["cwd"] or os.path.expanduser("~") for r in rows):
        n = sum(1 for r in rows if (r["cwd"] or os.path.expanduser("~")) == cwd)
        for _ in range(n):
            subprocess.run(["agent-tabs", "tab", cwd])


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-H", "--hours", type=float, default=36)
    ap.add_argument("--open", nargs="?", const="all", metavar="ROWS")
    ap.add_argument("--cmd", default=os.environ.get("CC_RECENT_CMD", "claude"))
    a = ap.parse_args()

    cutoff = time.time() - a.hours * 3600
    me = os.environ.get("CLAUDE_CODE_SESSION_ID")
    files = [p for p in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")) if os.path.getmtime(p) >= cutoff]
    rows = [r for r in map(read_session, files) if r["first"] or r["last"]]
    running = set()
    for f in glob.glob(os.path.expanduser("~/.claude*/sessions/*.json")):
        try:
            info = json.load(open(f))
        except (OSError, ValueError):
            continue
        if os.path.exists(f"/proc/{info.get('pid')}"):
            running.add(info.get("sessionId"))
    rows = [r for r in rows if r["id"] != me and r["id"] not in running]
    rows.sort(key=lambda r: r["mtime"], reverse=True)
    if not rows:
        print(f"No sessions in the last {a.hours:g}h.")
        return

    home = os.path.expanduser("~")
    for i, r in enumerate(rows, 1):
        cwd = (r["cwd"] or "?").replace(home, "~")
        print(f"{i:>2}. {datetime.fromtimestamp(r['mtime']):%a %H:%M}  {cwd}")
        print(f"    {one_line(r['name'], 90)}")
        if r["last"] and r["last"] != r["first"]:
            print(f"    last: {one_line(r['last'], 84)}")
        print(f"    cd {shlex.quote(r['cwd'] or '~')} && {a.cmd} --resume {r['id']}")

    if a.open:
        pick = rows if a.open == "all" else [rows[int(x) - 1] for x in a.open.split(",")]
        open_tabs(pick, a.cmd)


if __name__ == "__main__":
    main()
