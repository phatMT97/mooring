{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mooring",
  "version": "0.1.0",
  "identifier": "dev.phatmt3.mooring",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mooring",
        "width": 1100,
        "height": 700,
        "minWidth": 700,
        "minHeight": 400,
        "transparent": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": [
            "mica"
          ]
        },
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
